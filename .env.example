# ---------------------------------------------------------------------------
# Fernwood — backend credentials. Copy to `.env` and fill in.
# The root .gitignore already ignores `.env*` (with an exception for this file).
#
# NOTE: the AI Studio scaffold's GEMINI_API_KEY / APP_URL are gone. All
# inference now routes through TokenRouter; ElevenLabs handles audio only.
# ---------------------------------------------------------------------------

# --- TokenRouter: ALL image generation + ALL LLM calls (copy + critique) ---
# Get a key at https://www.tokenrouter.com. Keys look like sk-xxxxxxxx.
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1

# Optional hard-overrides. Leave blank to auto-probe GET /v1/models at startup
# and pick the first supported candidate. Set these if the probe picks badly —
# this is the live-demo panic button.
FERNWOOD_IMAGE_MODEL=
FERNWOOD_VISION_MODEL=

# Every TEXT-ONLY call runs here: marketing copy, voiceover scripts, text
# critique, and all five Campaign Brain lobes. Blank auto-probes and resolves to
# openai/gpt-5.4 — benchmarked at ~10s on a real brain prompt while honouring
# the strict json_schema the lobes depend on. Image critique needs to SEE, so it
# stays on FERNWOOD_VISION_MODEL.
#   Measured alternatives: openai/gpt-5.4-mini (5.6s, also clean),
#   anthropic/claude-sonnet-5 (~20s). Avoid google/gemini-3.5-flash (returns
#   unparseable JSON) and moonshotai/kimi-k3-free (>2min/call, 8 req/min cap).
FERNWOOD_TEXT_MODEL=

# Safety net if you pin a "*-free" text model: those carry hard request caps
# (kimi-k3-free allows 8/minute) and one campaign makes ~20 text calls, so
# requests to free models are paced client-side. Inert for paid models.
FERNWOOD_FREE_TIER_RPM=7
FERNWOOD_RATE_LIMIT_RETRIES=3
FERNWOOD_TEXT_REQUEST_TIMEOUT=120

# --- Voiceover ---
# auto | tokenrouter | deepgram | elevenlabs
#   auto (default) -> tokenrouter, then deepgram, then elevenlabs; falls through
#                     on ANY failure so one vendor's quota cannot cost you the
#                     voiceover. Naming a backend explicitly disables fallback.
FERNWOOD_TTS_PROVIDER=auto
# gpt-audio-mini, NOT gpt-audio: the latter rejects non-streaming audio output.
FERNWOOD_TTS_MODEL=openai/gpt-audio-mini
# alloy | ash | ballad | coral | echo | sage | shimmer | verse
FERNWOOD_TTS_VOICE=ash
FERNWOOD_ENABLE_TTS=true

# --- Deepgram: fallback voiceover + STT used by the audio verification tests ---
DEEPGRAM_API_KEY=
DEEPGRAM_TTS_MODEL=aura-2-thalia-en
DEEPGRAM_STT_MODEL=nova-3

# --- ElevenLabs: last-resort voiceover backend (free tier = 10k chars/month) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL=eleven_v3

# --- Storage: "local" (disk, no creds needed) or "b2" (Backblaze B2) ---
FERNWOOD_STORAGE=local

# Backblaze B2. Env var NAMES are dictated by genblaze's S3StorageBackend.
# Create an application key with read+write on the bucket at
# https://secure.backblaze.com/app_keys.htm
B2_BUCKET=fernwood-campaigns
B2_REGION=us-west-004
B2_KEY_ID=
B2_APP_KEY=

# --- Pipeline behaviour ---
FERNWOOD_MAX_ATTEMPTS=3
FERNWOOD_PASS_THRESHOLD=85
# Forces the first image critique to fail so the retry loop is always visible
# in a demo, while keeping the critique model's real reasoning text.
FERNWOOD_FORCE_FIRST_RETRY=true

# --- Brand film (opt-in per campaign via includeVideo) ---
FERNWOOD_VIDEO_MODEL=MiniMax-Hailuo-2.3
FERNWOOD_VIDEO_DURATION=6
FERNWOOD_VIDEO_SIZE=768P
FERNWOOD_ENABLE_VIDEO=true
# Write the SHA-256 manifest into the delivered mp4/jpg/mp3 containers.
FERNWOOD_EMBED_PROVENANCE=true

# --- Campaign Brain ---
# Per-brand persistent memory at brains/{slug}/brain.json: recalls the laws
# past rejections taught it, aims the run, predicts its own score, simulates
# audience reaction, and writes back what it learned. Strictly additive —
# false returns the pipeline to exactly its pre-brain behaviour.
FERNWOOD_ENABLE_BRAIN=true
